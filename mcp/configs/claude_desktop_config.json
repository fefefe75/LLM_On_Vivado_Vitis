{
  "_comment": "Copy into ~/.config/Claude/claude_desktop_config.json (Linux) or %APPDATA%/Claude/claude_desktop_config.json (Windows), then restart Claude Desktop.",
  "mcpServers": {
    "vivado-vitis": {
      "command": "/path/to/venv/bin/python",
      "args": [
        "-m",
        "vivado_mcp",
        "--workspace",
        "/path/to/your/fpga/project"
      ],
      "env": {
        "PYTHONPATH": "/path/to/LLM_On_Vivado_Vitis/mcp",
        "FPGA_MCP_TOOL_ROOT": "/tools/Xilinx",
        "FPGA_MCP_TIMEOUT": "3600"
      }
    }
  }
}

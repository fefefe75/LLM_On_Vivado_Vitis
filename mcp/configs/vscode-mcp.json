{
  "_commentaire": "VS Code / GitHub Copilot : a copier dans .vscode/mcp.json (ou en global). Le serveur s'ouvre en stdio.",
  "servers": {
    "vivado-vitis": {
      "type": "stdio",
      "command": "/chemin/vers/venv/bin/python",
      "args": [
        "-m",
        "vivado_mcp",
        "--workspace",
        "${workspaceFolder}"
      ],
      "env": {
        "PYTHONPATH": "/chemin/vers/LLM_On_Vivado_Vitis/mcp",
        "FPGA_MCP_TOOL_ROOT": "/tools/Xilinx"
      }
    }
  }
}
